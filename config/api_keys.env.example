# Threat Intelligence Platform - API Keys Configuration
# Copy this file to api_keys.env and fill in your actual API keys

# AlienVault OTX (Free)
# Get your key from: https://otx.alienvault.com/api
OTX_API_KEY=your_otx_api_key_here

# VirusTotal (Free tier available)
# Get your key from: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=your_virustotal_api_key_here

# AbuseIPDB (Free tier available)
# Get your key from: https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# PhishTank (Optional)
# Get your key from: https://www.phishtank.com/api_info.php
PHISHTANK_API_KEY=your_phishtank_api_key_here

# MISP
# Set after MISP server is running
MISP_API_KEY=your_misp_api_key_here

# SecurityTrails (Optional - for passive DNS)
# Get your key from: https://securitytrails.com/
SECURITYTRAILS_API_KEY=your_securitytrails_api_key_here

# SIEM Integration (Optional)
SPLUNK_HEC_URL=https://your-splunk-server:8088/services/collector
SPLUNK_HEC_TOKEN=your_splunk_hec_token_here

ELK_URL=http://your-elk-server:9200
ELK_API_KEY=your_elk_api_key_here

# Shodan (Optional - for additional enrichment)
# Get your key from: https://account.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# Database Credentials (for production use)
POSTGRES_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_password
ELASTICSEARCH_PASSWORD=change_this_password

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL=security-team@example.com
